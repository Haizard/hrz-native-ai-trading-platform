# Copy to `.env` and fill in. `.env` is gitignored -- never commit real values.
#
# The full reference, with what happens when each is absent, is in
# `docs/17-DEPLOYMENT-INFRA.md`. The short version: almost nothing here refuses to
# boot, so a missing variable shows up as one feature answering 503 rather than as
# a crash. Check this file deliberately.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The Postgres instance is hosted on Northflank. Paste the connection URL from
# the Northflank dashboard. Format:
#   postgres://<user>:<password>@<host>:<port>/<database>?sslmode=require
#
# Without it: `main` still serves /healthz, but every database-backed route
# answers 503, and RUN_MIGRATIONS=true refuses to start the entrypoint.
DATABASE_URL=postgres://user:password@host:5432/ai_trading?sslmode=require

# Signs the tokens /auth issues. At least 32 bytes; a short secret is refused at
# startup rather than accepted quietly, because a guessable signing key is a
# forgeable session.
#
# Generate one with:  openssl rand -base64 48
#
# Without it: /auth/* answers 503, and so does every route needing a token --
# /agent/* included, since those call a paid model.
JWT_SECRET=replace-me-with-at-least-32-random-bytes

# ---------------------------------------------------------------------------
# The AI agent -- the deployment's PRIMARY model
# ---------------------------------------------------------------------------
#
# One model every user gets by default, set once here (Northflank env vars).
# A user can bring their OWN provider + model + key instead, stored encrypted
# server-side via PUT /agent/provider-config; that overrides the primary for
# that user only. The primary below is what everyone else gets.
#
# AI_PROVIDER selects the provider. Accepted: bedrock (default), openai,
# anthropic, openrouter, deepseek, grok, huggingface, openai-compat.
#AI_PROVIDER=bedrock

# Model id as the provider spells it. Optional for providers with a built-in
# default; required for openai-compat (which also needs AI_BASE_URL).
#AI_MODEL=gpt-4o

# The provider's API key. Required for every Chat Completions provider;
# NOT for bedrock, which authenticates with the AWS credentials below.
#AI_API_KEY=

# Endpoint override. Optional for the named providers (each has a default);
# REQUIRED for openai-compat, e.g. https://gateway.internal/v1.
#AI_BASE_URL=

# Per-request timeout in seconds. Default 180: a reasoning model walking a
# timeframe ladder can legitimately take a minute.
#AI_TIMEOUT_SECS=180

# --- Bedrock (the default provider keeps its original variables) -----------

# Model id as Bedrock spells it. No default: the model is a decision, not a guess.
# Without it, /agent/* answers 503 naming the variable.
AWS_BEDROCK_MODEL_ID=qwen.qwen3-coder-next

# Defaults to us-east-1 if unset.
AWS_BEDROCK_REGION=us-east-1

# Without either key, /agent/* answers 503.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only for temporary (STS) credentials. Leave unset for a long-lived IAM user.
# AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# Live trading
# ---------------------------------------------------------------------------

# The key-encryption key for **users' own** broker credentials (migration 0007).
#
# A user connects their own exchange account at `POST /brokers`; the API key and
# secret are sealed with AES-256-GCM under this key and the ciphertext -- never
# the key -- is what the database holds. It is read once at startup.
#
# Generate one with:  openssl rand -base64 32
#
# **This value cannot be regenerated.** It is the only thing that can open the
# rows already stored; lose it and every user must re-enter their keys. Back it
# up wherever JWT_SECRET is backed up, and rotate it by re-connecting accounts,
# not by replacing it.
#
# Without it: /brokers answers 503, no user can connect an account, and no live
# bot can be started -- because a live bot trades its owner's account and never
# the deployment's. Charts, analytics and the agent are unaffected.
# BROKER_KEK=

# The *deployment's* own credentials, for `xtask` and the CLI tools. These are
# not what a user's bot trades any more: a live bot always trades the account
# its owner connected, and `POST /bots` refuses one with no broker account.
#
# Named {VENUE}_API_KEY / {VENUE}_API_SECRET, with the venue upper-cased.
# `binance` is the only venue with an adapter, so these two names are the whole
# list today. The sandbox never sees them (docs/15-RISK-COMPLIANCE.md).
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Where the live client points, for the deployment's own keys *and* for user
# accounts -- so a testnet set here moves both. Set once at startup.
# BINANCE_BASE_URL=https://api.binance.com

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Optional. Opens a Binance feed for a symbol when a bot or a chart needs one.
# Defaults to `off`: bots run and receive nothing, and say so -- a bot that is
# `running` with no feed looks identical to one that is running and finding no
# setups, and only one of those is a problem.
# MARKET_FEED=binance

# Optional. Unset means alerts go to the log and the audit trail only.
# ALERT_WEBHOOK_URL=

# Optional. Per-user limits on /agent/*, which call a paid model.
# AGENT_REQUESTS_PER_MINUTE=30
# AGENT_BURST=5

# Optional: pool sizing for the API gateway / collectors.
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=10
# Statements slower than this are logged, with the full SQL. sqlx defaults to
# 1000ms, which fires on ordinary chunked upserts against a managed instance
# over the network -- and each warning dumps the whole statement.
DB_SLOW_STATEMENT_MS=5000

# Logging. See tracing-subscriber EnvFilter syntax.
# e.g. `info`, `debug`, `ai_trading_platform=debug,sqlx=warn`
RUST_LOG=info

# `json` for machine-readable logs in deployment; default is human-readable lines.
# LOG_FORMAT=json

# Where the agent's methodology documents and the workstation are read from.
# Both have working defaults; override for a mounted volume.
# SKILLS_DIR=skills
# FRONTEND_DIR=frontend/app

# The local default is 127.0.0.1:8080. The container image sets 0.0.0.0:8080,
# because loopback inside a container is unreachable from outside it.
# BIND_ADDR=0.0.0.0:8080

# The entrypoint applies migrations, then execs the command. Set to false if you
# would rather run `xtask migrate` as a dedicated job.
# RUN_MIGRATIONS=true
