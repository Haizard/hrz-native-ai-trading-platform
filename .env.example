# Copy to `.env` and fill in. `.env` is gitignored -- never commit real values.
#
# The Postgres instance is hosted on Northflank. Paste the connection URL you
# get from the Northflank dashboard here. Format:
#   postgres://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/ai_trading?sslmode=require

# Optional: pool sizing for the API gateway / collectors.
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=10
# Statements slower than this are logged, with the full SQL. sqlx defaults to
# 1000ms, which fires on ordinary chunked upserts against a managed instance
# over the network -- and each warning dumps the whole statement.
DB_SLOW_STATEMENT_MS=5000

# Logging. See tracing-subscriber EnvFilter syntax.
# e.g. `info`, `debug`, `ai_trading_platform=debug,sqlx=warn`
RUST_LOG=info

# Phase 5+ only -- LLM provider credentials. Never log these, never let them
# reach the WASM sandbox (docs/15-RISK-COMPLIANCE.md).
#
# Primary provider is AWS Bedrock (model qwen.qwen3-coder-next, us-east-1).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEDROCK_REGION=us-east-1
# AWS_BEDROCK_MODEL_ID=qwen.qwen3-coder-next
#
# Secondary / fallback providers, if we add them later:
# LLM_PROVIDER=
# LLM_API_KEY=
