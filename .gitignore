# Rust build artifacts
/target/
**/target/
# Isolated integration-test target dir (agent scratch, same class as /target/)
/target-itest/

# Local agent working memory (project-local scratch, not source)
.workbuddy-ai/

# Local visual brainstorming sessions and other agent scratch artifacts.
.superpowers/

# Browser-verification screenshots from local runs (evidence, not source).
/test-shots/

# Environment / secrets -- NEVER commit real credentials
.env
.env.*
!.env.example

# sqlx offline query cache (generated; regenerate with `cargo sqlx prepare`)
.sqlx/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local data dumps
*.dump
/backups/

# Node (only if the React+TS fallback path from docs/14 is chosen)
node_modules/
frontend/app/dist/
frontend/app/.turbo/

# A live paper-bot run writes its own console log here. The audit trail that
# matters is in Postgres; this is just the terminal output, and it is not worth
# committing by the hour.
reports/paper-bot-*.log

# Same for the bounded soaks: the observation is written up in
# `reports/phase1-verification.md` and `reports/phase6-verification.md`, and the
# log itself is megabytes of sqlx slow-statement warnings.
reports/*-soak.log

# Scratch output from long test/build runs -- console output, not evidence.
# Anything worth keeping is written up in `reports/*.md` or `docs/`.
/.cargo-logs/

# Root-level run/test logs (gateway_*, phase_*, s1_/s2_/s3_*, cheat_*, server*)
# -- the same class as /.cargo-logs/: console output, not evidence.
/*.log
/*.err

# Agent session scratch: pasted chart screenshots, captured request/response
# payloads and one-off diagnostic dumps. Diagnostics worth keeping are
# promoted into tools/ as real scripts.
/.freebuff/
/*.jpg

# Local agent harness state (same class as .workbuddy-ai/ and .superpowers/).
.agents/
.commandcode/
